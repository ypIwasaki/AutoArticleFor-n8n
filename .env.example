# For migration, restore the existing .env; do not replace it with this template.
# This template alone does not initialize the project DB or n8n state.
# See docs/pc-migration.md.
# Local n8n runtime
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
GENERIC_TIMEZONE=Asia/Tokyo
TZ=Asia/Tokyo
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_RUNNERS_ENABLED=true

# Docker-only setting. The supported WSL/npm launcher keeps the key in ~/.n8n/config.
# Do not export this placeholder into the npm process environment.
# Preserve the existing n8n key when migrating credentials.
N8N_ENCRYPTION_KEY=change-me-before-production

# Optional future integrations. Keep real values in .env or n8n Credentials only.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
NEWS_API_KEY=
SERPAPI_API_KEY=
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=

# n8n API sync. Keep N8N_API_KEY in .env only.
N8N_API_BASE_URL=http://localhost:5678
N8N_API_KEY=
N8N_WORKFLOW_ID=
N8N_WORKFLOW_NAME=Daily Keyword News Summary
N8N_WORKFLOW_FILE=n8n/workflows/daily-keyword-news-summary.workflow.json

# Project paths are configured by the startup script / Docker Compose.
# npm/WSL: scripts/start_n8n_with_file_access.sh detects the repository root.
# Docker: /project is the repository bind mount inside the container.
# Direct n8n startup must export PROJECT_ROOT as the absolute repository path,
# allow that path with N8N_RESTRICT_FILE_ACCESS_TO, and set
# N8N_BLOCK_ENV_ACCESS_IN_NODE=false for workflow path expressions.

# Phase 6: authenticated loopback reads; set a private random token of at least 32 characters.
AUTOARTICLE_DB_SERVICE_URL=http://127.0.0.1:8766
AUTOARTICLE_DB_SERVICE_TOKEN=
